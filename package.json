{
  "name": "oikist",
  "version": "0.0.0",
  "private": true,
  "description": "An agent-native development environment for Windows",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify": "npm run typecheck && npm test",
    "test": "node --import tsx --test --test-force-exit \"tests/*.test.ts\"",
    "bench": "node --import tsx tests/throughput.bench.mts",
    "app": "electron .",
    "package": "npm run build && node scripts/make-icon.mjs && electron-builder --win --dir"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "4.3.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "license": "Apache-2.0",
  "author": "Srihith Jarabana"
}
